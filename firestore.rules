 rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    function isMemberFromResource() {
      return signedIn()
        && resource.data.members is list
        && uid() in resource.data.members;
    }

    function isMemberFromRequest() {
      return signedIn()
        && request.resource.data.members is list
        && uid() in request.resource.data.members;
    }

    function isTripMember(tripId) {
      return signedIn()
        && uid() in get(/databases/$(database)/documents/trips/$(tripId)).data.members;
    }

    function isTripCreator(tripId) {
      return signedIn()
        && get(/databases/$(database)/documents/trips/$(tripId)).data.createdBy == uid();
    }

    // Validates a join operation: only appends the caller's own uid, nothing else changes.
    function onlyJoinSelf() {
      return signedIn()
        && resource.data.members is list
        && request.resource.data.members is list
        && request.resource.data.members.size() == resource.data.members.size() + 1
        && request.resource.data.members.hasAll(resource.data.members)
        && uid() in request.resource.data.members
        && request.resource.data.diff(resource.data).changedKeys().hasOnly(['members', 'updatedAt']);
    }

    function identityMapForwardUnique() {
      return !(request.resource.data.diff(resource.data).changedKeys().hasAny(['identityMap']))
        || !(resource.data.identityMap is map && uid() in resource.data.identityMap)
        || request.resource.data.identityMap[uid()] == resource.data.identityMap[uid()];
    }

    // ── Shared collaborative trips ──────────────────────────────────────────
    match /trips/{tripId} {
      // allow get: if signedIn(); allows anyone logged in to "check" a trip ID for joining.
      // allow list: if signedIn(); allows querying. The where() clause filters to only trips the user is in.
      allow get:    if signedIn();
      allow list:   if signedIn();

      allow create: if isMemberFromRequest() && request.resource.data.createdBy == uid();
      // Member update: existing members can update, with identity-map forward-only guard.
      // Join operation: non-members can only append themselves via onlyJoinSelf(),
      // without the identityMap guard (identityMap may not exist yet on first join).
      allow update: if (isMemberFromResource() && identityMapForwardUnique())
                    || onlyJoinSelf();

      // Only the trip creator can delete.
      allow delete: if signedIn() && resource.data.createdBy == uid();

      // ── Expenses subcollection ──────────────────────────────────────────
      match /expenses/{expenseId} {
        function getPayerId(data) {
          return data.get('payerId', data.get('paidBy', null));
        }
        
        function isValidPayer(data) {
          let payerId = getPayerId(data);
          let tripData = get(/databases/$(database)/documents/trips/$(tripId)).data;
          return payerId != null && (
            (tripData.memberRegistry is map && payerId in tripData.memberRegistry) ||
            (tripData.participants is list && payerId in tripData.participants) ||
            (!(tripData.memberRegistry is map) && !(tripData.participants is list))
          );
        }

        allow read: if isTripMember(tripId);
        allow create: if isTripMember(tripId) && isValidPayer(request.resource.data);
        allow update: if isTripMember(tripId) 
                      && (!request.resource.data.diff(resource.data).changedKeys().hasAny(['payerId', 'paidBy']) 
                          || isValidPayer(request.resource.data));
        allow delete: if isTripMember(tripId);
      }

      // ── Settlements subcollection ───────────────────────────────────────
      match /settlements/{settlementId} {

        allow read: if isTripMember(tripId);

        // ── CREATE ─────────────────────────────────────────────────────────
        // Only the sender can open a record.
        // Initial status MUST be 'pending' — never 'paid' or 'completed'.
        // toUserId must be null — receiver sets it on first confirm.
        // creatorOverride must be false on creation.
        allow create: if isTripMember(tripId)
          && request.resource.data.fromUserId == uid()
          && request.resource.data.toUserId   == null
          && (request.resource.data.status == 'pending' || request.resource.data.status == 'paid')
          && (
            request.resource.data.get('creatorOverride', false) == false
            || (isTripCreator(tripId) && request.resource.data.creatorOverride == true)
          );

        // ── UPDATE ─────────────────────────────────────────────────────────
        // Immutable core fields — never change after creation.
        // Active-flag protection — flags may only change when status changes.
        // Strict transition whitelist — only the 3 valid transitions allowed.
        allow update: if isTripMember(tripId)

          // ── Immutable fields ──────────────────────────────────────────────
          && request.resource.data.from   == resource.data.from
          && request.resource.data.to     == resource.data.to
          && request.resource.data.amount == resource.data.amount

          && (

            // ── Path 0: Creator flag-only update ─────────────────────────
            // Trip creator propagates member isActive changes to settlement
            // documents when a member is removed or restored.
            // Status must be unchanged. Only fromMemberActive, toMemberActive,
            // and updatedAt may differ. creatorOverride must stay false.
            // This path cannot be used to change status or financial fields.
            (
              isTripCreator(tripId)
              && request.resource.data.status       == resource.data.status
              && request.resource.data.fromUserId   == resource.data.fromUserId
              && request.resource.data.toUserId     == resource.data.toUserId
              && request.resource.data.get('creatorOverride', false) == false
              && request.resource.data.diff(resource.data).affectedKeys()
                   .hasOnly(['fromMemberActive', 'toMemberActive', 'updatedAt'])
            )

            ||

            // ── Transition paths (Paths 1–7) ──────────────────────────────
            // For all transition writes: active flags may only change when
            // status is also changing. If status is unchanged, flags must stay.
            (
              (
                request.resource.data.status != resource.data.status
                || (
                  request.resource.data.get('fromMemberActive', true) == resource.data.get('fromMemberActive', true)
                  && request.resource.data.get('toMemberActive', true) == resource.data.get('toMemberActive', true)
                )
              )

              && (

                // ── Path 1: Sender — pending → paid ────────────────────────
                (
                  resource.data.status            == 'pending'
                  && request.resource.data.status == 'paid'
                  && resource.data.fromUserId      == uid()
                  && request.resource.data.fromUserId == uid()
                  && resource.data.toUserId        == null
                  && request.resource.data.toUserId == null
                  && request.resource.data.get('creatorOverride', false) == false
                )

                ||

                // ── Path 2: Sender retract — paid → pending ─────────────────
                (
                  resource.data.status            == 'paid'
                  && request.resource.data.status == 'pending'
                  && resource.data.fromUserId      == uid()
                  && request.resource.data.fromUserId == uid()
                  && resource.data.toUserId        == null
                  && request.resource.data.toUserId == null
                  && request.resource.data.get('creatorOverride', false) == false
                )

                ||

                // ── Path 3: Receiver first-time confirm — paid → completed ──
                (
                  resource.data.status            == 'paid'
                  && request.resource.data.status == 'completed'
                  && resource.data.toUserId        == null
                  && request.resource.data.toUserId == uid()
                  && request.resource.data.fromUserId == resource.data.fromUserId
                  && isTripMember(tripId)
                  && request.resource.data.get('creatorOverride', false) == false
                )

                ||

                // ── Path 4: Receiver reopen — completed → pending ───────────
                (
                  resource.data.status            == 'completed'
                  && request.resource.data.status == 'pending'
                  && resource.data.toUserId        == uid()
                  && request.resource.data.fromUserId == resource.data.fromUserId
                  && request.resource.data.get('creatorOverride', false) == false
                )

                ||

                // ── Path 5: Creator fallback — pending → paid ───────────────
                (
                  resource.data.status            == 'pending'
                  && request.resource.data.status == 'paid'
                  && isTripCreator(tripId)
                  && resource.data.get('fromMemberActive', true) == false
                  && request.resource.data.creatorOverride == true
                )

                ||

                // ── Path 6: Creator fallback — paid → completed ─────────────
                (
                  resource.data.status            == 'paid'
                  && request.resource.data.status == 'completed'
                  && isTripCreator(tripId)
                  && resource.data.get('toMemberActive', true) == false
                  && request.resource.data.creatorOverride == true
                )

                ||

                // ── Path 7: Creator fallback — completed → pending ──────────
                (
                  resource.data.status            == 'completed'
                  && request.resource.data.status == 'pending'
                  && isTripCreator(tripId)
                  && resource.data.get('toMemberActive', true) == false
                  && request.resource.data.creatorOverride == true
                )

              )
            )

          );

        // ── DELETE ─────────────────────────────────────────────────────────
        // Only the sender can delete their own record.
        allow delete: if isTripMember(tripId)
          && resource.data.fromUserId == uid();
      }

      // ── Settlement history subcollection ───────────────────────────────
      // Append-only audit trail — members can create, nobody can edit or delete.
      match /settlementHistory/{entryId} {
        allow read:           if isTripMember(tripId);
        allow create:         if isTripMember(tripId);
        allow update, delete: if false;
      }
    }

    // ── Per-user personal backup (solo / legacy mode) ───────────────────────
    match /users/{userId}/trips/{tripId} {
      allow read, write: if signedIn() && uid() == userId;

      match /expenses/{expenseId} {
        allow read, write: if signedIn() && uid() == userId;
      }
    }
  }
}
