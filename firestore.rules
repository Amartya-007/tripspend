rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    function isMemberFromResource() {
      return signedIn()
        && resource.data.members is list
        && uid() in resource.data.members;
    }

    function isMemberFromRequest() {
      return signedIn()
        && request.resource.data.members is list
        && uid() in request.resource.data.members;
    }

    function isTripMember(tripId) {
      return signedIn()
        && uid() in get(/databases/$(database)/documents/trips/$(tripId)).data.members;
    }

    function isTripCreator(tripId) {
      return signedIn()
        && get(/databases/$(database)/documents/trips/$(tripId)).data.createdBy == uid();
    }

    // Validates a join operation: only appends the caller's own uid, nothing else changes.
    function onlyJoinSelf() {
      return signedIn()
        && resource.data.members is list
        && request.resource.data.members is list
        && request.resource.data.members.size() == resource.data.members.size() + 1
        && request.resource.data.members.hasAll(resource.data.members)
        && uid() in request.resource.data.members
        && request.resource.data.diff(resource.data).changedKeys().hasOnly(['members', 'updatedAt']);
    }

    // ── Shared collaborative trips ──────────────────────────────────────────
    match /trips/{tripId} {
      allow read:   if isMemberFromResource();
      allow create: if isMemberFromRequest();
      allow update: if isMemberFromResource() || onlyJoinSelf();

      // Only the trip creator can delete.
      allow delete: if signedIn() && resource.data.createdBy == uid();

      // ── Expenses subcollection ──────────────────────────────────────────
      match /expenses/{expenseId} {
        allow read, write: if isMemberFromResource();
      }

      // ── Settlements subcollection ───────────────────────────────────────
      match /settlements/{settlementId} {

        allow read: if isTripMember(tripId);

        // ── CREATE ─────────────────────────────────────────────────────────
        // Only the sender can open a record.
        // Initial status MUST be 'pending' — never 'paid' or 'completed'.
        // toUserId must be null — receiver sets it on first confirm.
        // creatorOverride must be false on creation.
        allow create: if isTripMember(tripId)
          && request.resource.data.fromUserId == uid()
          && request.resource.data.toUserId   == null
          && request.resource.data.status     == 'pending'
          && request.resource.data.get('creatorOverride', false) == false;

        // ── UPDATE ─────────────────────────────────────────────────────────
        // Immutable core fields — never change after creation.
        // Active-flag protection — flags may only change when status changes.
        // Strict transition whitelist — only the 3 valid transitions allowed.
        allow update: if isTripMember(tripId)

          // ── Immutable fields ──────────────────────────────────────────────
          && request.resource.data.from   == resource.data.from
          && request.resource.data.to     == resource.data.to
          && request.resource.data.amount == resource.data.amount

          // ── Active-flag protection ────────────────────────────────────────
          // fromMemberActive and toMemberActive may only change when status
          // is also changing. If status is unchanged, flags must stay the same.
          && (
            request.resource.data.status != resource.data.status
            || (
              request.resource.data.get('fromMemberActive', true) == resource.data.get('fromMemberActive', true)
              && request.resource.data.get('toMemberActive', true)   == resource.data.get('toMemberActive', true)
            )
          )

          && (

            // ── Path 1: Sender — pending → paid ──────────────────────────
            // Sender marks payment sent. toUserId must still be null
            // (receiver hasn't confirmed yet), preventing race conditions.
            (
              resource.data.status     == 'pending'
              && request.resource.data.status == 'paid'
              && resource.data.fromUserId      == uid()
              && request.resource.data.fromUserId == uid()
              && resource.data.toUserId        == null
              && request.resource.data.toUserId == null
              && request.resource.data.get('creatorOverride', false) == false
            )

            ||

            // ── Path 2: Sender retract — paid → pending ───────────────────
            // Sender can retract ONLY before receiver has confirmed
            // (toUserId still null). Cannot retract after receiver acts.
            (
              resource.data.status     == 'paid'
              && request.resource.data.status == 'pending'
              && resource.data.fromUserId      == uid()
              && request.resource.data.fromUserId == uid()
              && resource.data.toUserId        == null
              && request.resource.data.toUserId == null
              && request.resource.data.get('creatorOverride', false) == false
            )

            ||

            // ── Path 3: Receiver first-time confirm — paid → completed ────
            // Receiver sets their uid and moves to completed.
            // This is the first time toUserId is written (was null on create).
            (
              resource.data.status     == 'paid'
              && request.resource.data.status == 'completed'
              && resource.data.toUserId        == null
              && request.resource.data.toUserId == uid()
              && request.resource.data.fromUserId == resource.data.fromUserId
              && isTripMember(tripId)
              && request.resource.data.get('creatorOverride', false) == false
            )

            ||

            // ── Path 4: Receiver reopen — completed → pending ─────────────
            // Receiver can reopen a completed settlement.
            (
              resource.data.status     == 'completed'
              && request.resource.data.status == 'pending'
              && resource.data.toUserId        == uid()
              && request.resource.data.fromUserId == resource.data.fromUserId
              && request.resource.data.get('creatorOverride', false) == false
            )

            ||

            // ── Path 5: Creator fallback — pending → paid ─────────────────
            // Trip creator acts on behalf of an inactive sender.
            // fromMemberActive must be false (denormalized on the doc).
            // creatorOverride must be set to true by this write.
            (
              resource.data.status     == 'pending'
              && request.resource.data.status == 'paid'
              && isTripCreator(tripId)
              && resource.data.get('fromMemberActive', true) == false
              && request.resource.data.creatorOverride == true
            )

            ||

            // ── Path 6: Creator fallback — paid → completed ───────────────
            // Trip creator confirms receipt on behalf of an inactive receiver.
            // toMemberActive must be false (denormalized on the doc).
            // creatorOverride must be set to true by this write.
            (
              resource.data.status     == 'paid'
              && request.resource.data.status == 'completed'
              && isTripCreator(tripId)
              && resource.data.get('toMemberActive', true) == false
              && request.resource.data.creatorOverride == true
            )

            ||

            // ── Path 7: Creator fallback — completed → pending (reopen) ───
            // Trip creator reopens on behalf of an inactive receiver.
            (
              resource.data.status     == 'completed'
              && request.resource.data.status == 'pending'
              && isTripCreator(tripId)
              && resource.data.get('toMemberActive', true) == false
              && request.resource.data.creatorOverride == true
            )

          );

        // ── DELETE ─────────────────────────────────────────────────────────
        // Only the sender can delete their own record.
        allow delete: if isTripMember(tripId)
          && resource.data.fromUserId == uid();
      }

      // ── Settlement history subcollection ───────────────────────────────
      // Append-only audit trail — members can create, nobody can edit or delete.
      match /settlementHistory/{entryId} {
        allow read:           if isTripMember(tripId);
        allow create:         if isTripMember(tripId);
        allow update, delete: if false;
      }
    }

    // ── Per-user personal backup (solo / legacy mode) ───────────────────────
    match /users/{userId}/trips/{tripId} {
      allow read, write: if signedIn() && uid() == userId;

      match /expenses/{expenseId} {
        allow read, write: if signedIn() && uid() == userId;
      }
    }
  }
}
