# Auto-detect text files and normalize line endings to LF
* text=auto eol=lf

# Force LF for source files
*.ts    text eol=lf
*.tsx   text eol=lf
*.js    text eol=lf
*.jsx   text eol=lf
*.json  text eol=lf
*.css   text eol=lf
*.html  text eol=lf
*.md    text eol=lf
*.xml   text eol=lf
*.gradle text eol=lf
*.properties text eol=lf

# Force LF for shell scripts
*.sh    text eol=lf
gradlew text eol=lf

# Binary files - no line ending conversion
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.jks   binary
*.keystore binary
